gpui-alloy #desktop #gui #immediate
Zed's GPU-accelerated UI framework
version: 0.1.1
license: Apache-2.0
rust-version: unknown
documentation: https://docs.rs/gpui-alloy/0.1.1
homepage: https://gpui.rs
repository: https://github.com/AprilNEA/gpui-alloy
crates.io: https://crates.io/crates/gpui-alloy/0.1.1
features:
 +default          = [font-kit, wayland, x11, windows-manifest]
  font-kit         = [dep:font-kit]
  wayland          = []
  windows-manifest = [dep:embed-resource]
  x11              = [scap?/x11]
  backtrace        = [dep:backtrace]
  bench            = [bench-support]
  bench-support    = [profiler, dep:criterion]
  inspector        = [gpui_macros/inspector]
  leak-detection   = [backtrace]
  objc2            = [dep:objc2]
  objc2-metal      = [dep:objc2-metal]
  profiler         = [dep:hdrhistogram]
  proptest         = [dep:proptest]
  scap             = [dep:scap]
  screen-capture   = [scap]
  stacker          = [dep:stacksafe]
  test-support     = [leak-detection, collections/test-support, http_client/test-support, wayland, x11, proptest]
